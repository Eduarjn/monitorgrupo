# ============================================================================
# /opt/evolution/.env   —   modo 0600, dono root
#
# Gere os dois segredos ANTES de colar (não use os do exemplo):
#   openssl rand -hex 32     → AUTHENTICATION_API_KEY
#   openssl rand -hex 32     → o mesmo valor vai em CAPTURA_WEBHOOK_SEGREDO,
#                              no .env DA NOSSA API (o outro arquivo, abaixo)
# ============================================================================

SERVER_URL=http://127.0.0.1:8081
SERVER_PORT=8081
SERVER_TYPE=http

# TROCAR. O default do .env.example da Evolution é público e conhecido.
AUTHENTICATION_API_KEY=COLE_AQUI_O_OPENSSL_RAND_HEX_32

# --- banco -----------------------------------------------------------------
# DATABASE_ENABLED=true é obrigatório: sem ela TODO o bloco DATABASE_* é
# ignorado e a sessão não persiste — cada restart pediria QR de novo.
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:SENHA@127.0.0.1:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution

# Guardar a mensagem no banco da Evolution começa em `true` de propósito: não há
# confirmação de que `false` não quebra o caminho do webhook. Depois que a
# captura estiver validada, tente `false` e confirme que as mensagens continuam
# chegando — é armazenamento duplicado do conteúdo, então vale desligar.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# --- cache -----------------------------------------------------------------
# Redis desligado: há bug recorrente de "redis disconnected" em compose, e o
# cache local basta para uma instância. Menos um container, menos RAM.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# --- webhook ---------------------------------------------------------------
# GLOBAL desligado. Se ligar este E o da instância, cada mensagem chega DUAS
# vezes — e a segunda passa no dedup, então o sintoma é só custo dobrado de IA.
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_REQUEST_TIMEOUT_MS=15000
WEBHOOK_RETRY_MAX_ATTEMPTS=6
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true

# --- sessão ----------------------------------------------------------------
# 6 e não 30: trinta QRs seguidos é uma sessão pendurada gerando código para
# ninguém. Melhor abortar e a tela pedir "gerar QR" de novo.
QRCODE_LIMIT=6
QRCODE_COLOR=#2C353D
CONFIG_SESSION_PHONE_CLIENT=ERA Monitor
CONFIG_SESSION_PHONE_NAME=Chrome

DEL_INSTANCE=false
TELEMETRY_ENABLED=false
LOG_LEVEL=ERROR
LOG_BAILEYS=error


# ============================================================================
# BLOCO PARA O OUTRO ARQUIVO: /opt/whatsapp-monitor/.env
# (o .env da NOSSA API, que já tem JWT_SECRET, PGURL, CONEXAO_CHAVE_V1…)
# ----------------------------------------------------------------------------
# EVOLUTION_URL=http://127.0.0.1:8081
# EVOLUTION_APIKEY=<o MESMO valor de AUTHENTICATION_API_KEY acima>
# CAPTURA_WEBHOOK_SEGREDO=<o segundo openssl rand -hex 32>
# CAPTURA_CALLBACK=http://127.0.0.1:3020/captura/webhook
# CAPTURA_INSTANCIA=monitor-grupos
#
# Depois de editar:
#   chmod 600 /opt/whatsapp-monitor/.env
#   systemctl restart whatsapp-monitor.service
#
# CAPTURA_WEBHOOK_SEGREDO é o header que a Evolution devolve em cada POST. Ele
# NÃO vai para o banco: é comparado em toda mensagem, e um SELECT + decifra por
# mensagem seria absurdo. Rotacionar = trocar aqui e chamar "Preparar captura"
# de novo no painel (que reescreve o webhook na Evolution).
# ============================================================================
